---
import Icon from '../components/Icon.astro';
import { projects } from '../data/projects';
import '../styles/global.css';
const github = 'https://github.com/OpenALC';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="探索 OpenALC 的开源项目：Cluster Link 桌面网络工具与 Cluster Route 本地模型网关。连接网络、路由模型，一起构建实用的开发工具。" />
    <meta name="theme-color" content="#f7f8f2" />
    <meta property="og:title" content="OpenALC — 让连接更自由，让工具更开放" />
    <meta property="og:description" content="探索 Cluster Link 与 Cluster Route，参与 OpenALC 开源项目。" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://openalc.github.io/" />
    <link rel="icon" type="image/svg+xml" href="/brand/cluster-route.svg" />
    <link rel="canonical" href="https://openalc.github.io/" />
    <title>OpenALC — 让连接更自由，让工具更开放</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到主要内容</a>
    <header class="header">
      <a class="brand" href="#" aria-label="OpenALC 首页"><span class="brand-mark"><img src="/brand/cluster-route.svg" width="36" height="36" alt="" /></span>OpenALC<span class="brand-dot">/</span></a>
      <nav aria-label="主导航"><a href="#projects">开源项目</a><a href="#about">关于我们</a><a href="#contribute">参与贡献</a></nav>
      <a class="header-github" href={github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={18}/><span>GitHub</span><span aria-hidden="true">↗</span></a>
      <button class="menu-button" aria-expanded="false" aria-controls="mobile-nav" aria-label="打开导航"><span></span><span></span></button>
    </header>
    <nav id="mobile-nav" class="mobile-nav" aria-label="移动端导航" hidden><a href="#projects">开源项目</a><a href="#about">关于我们</a><a href="#contribute">参与贡献</a><a href={github}>GitHub ↗</a></nav>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="eyebrow"><span class="status-dot"></span> OPEN SOURCE. OPEN POSSIBILITIES.</div>
          <h1 id="hero-title">让连接更自由<span>让工具更<span class="word-open">开放<svg viewBox="0 0 150 15" aria-hidden="true"><path d="M3 10Q65 0 147 7"/></svg></span><span class="title-period">.</span></span></h1>
          <p class="hero-description">从网络连接到模型路由，<br class="desktop-break"/>我们用开放的代码，构建更顺手的工具。</p>
          <div class="hero-actions"><a class="button button-dark" href="#projects">探索开源项目 <Icon /></a><a class="text-link" href={github} target="_blank" rel="noopener noreferrer">在 GitHub 上找到我们 <span aria-hidden="true">↗</span></a></div>
          <div class="hero-footnote"><span class="tiny-cross">+</span> BUILT IN THE OPEN. MADE FOR EVERYONE.</div>
        </div>
        <div class="network-panel" aria-label="网络连接与模型路由架构示意">
          <div class="panel-top"><span><i></i> THE OPENALC ECOSYSTEM</span><span class="panel-index">FIG. 001</span></div>
          <div class="diagram">
            <svg class="connection-lines" viewBox="0 0 520 340" preserveAspectRatio="none" aria-hidden="true"><path class="wire" d="M88 80H175Q190 80 190 95V150H260M88 260H175Q190 260 190 245V190H260M260 170H330Q345 170 345 155V80H440M345 170V250Q345 260 360 260H440"/><path class="wire-flow" d="M88 80H175Q190 80 190 95V150H260M260 170H330Q345 170 345 155V80H440"/><circle cx="190" cy="150" r="3"/><circle cx="345" cy="170" r="3"/></svg>
            <div class="endpoint endpoint-one"><span class="node-symbol">⌘</span><span>YOUR NETWORK</span></div>
            <div class="endpoint endpoint-two"><Icon name="code" size={27}/><span>YOUR CLIENT</span></div>
            <div class="core"><img src="/brand/cluster-route.svg" width="48" height="48" alt="" /><strong>OpenALC</strong><span>CONNECT. ROUTE.</span></div>
            <div class="endpoint endpoint-three"><span class="node-symbol">◎</span><span>OPEN NETWORK</span></div>
            <div class="endpoint endpoint-four"><span class="node-symbol">✳</span><span>MODEL PROVIDERS</span></div>
            <span class="diagram-tag tag-link">Cluster Link</span><span class="diagram-tag tag-route">Cluster Route</span>
          </div>
          <div class="diagram-selector" role="group" aria-label="查看架构说明"><button class="diagram-option active" data-mode="link" aria-pressed="true"><Icon name="link" size={16}/>网络连接</button><button class="diagram-option" data-mode="route" aria-pressed="false"><Icon name="route" size={16}/>模型路由</button></div>
          <div class="panel-caption"><span id="diagram-caption" aria-live="polite">可视化管理配置、代理节点与路由规则。</span><span class="caption-dot"></span></div>
          <div class="panel-note">CONCEPT DIAGRAM / 架构示意</div>
        </div>
      </section>
      <div class="principle-strip wrap"><span><Icon name="code" size={18}/>开放源代码</span><span><Icon name="link" size={18}/>连接更多可能</span><span><Icon name="route" size={18}/>本地工具体验</span><span class="strip-end">SMALL TOOLS. REAL POSSIBILITIES. <span aria-hidden="true">↘</span></span></div>
      <section id="projects" class="projects wrap" aria-labelledby="projects-title">
        <div class="section-heading"><div><span class="eyebrow section-kicker">01 / OUR PROJECTS</span><h2 id="projects-title">开放代码，实用工具<span>.</span></h2></div><a class="text-link" href={`${github}?tab=repositories`} target="_blank" rel="noopener noreferrer">查看全部仓库 <span aria-hidden="true">↗</span></a></div>
        <div class="project-grid">
          {projects.map((project, index) => <article class:list={['project-card', index === 0 ? 'project-link' : 'project-route']}>
            <div class="project-visual" aria-hidden="true">
              <div class="visual-top"><span>{project.category}</span><span>PROJECT {project.number}</span></div>
              {index === 0 ? <div class="link-visual"><span class="link-orbit orbit-one"></span><span class="link-orbit orbit-two"></span><span class="link-orbit orbit-three"></span><div class="visual-icon"><Icon name="link" size={54}/></div><span class="visual-chip chip-one">CONFIG</span><span class="visual-chip chip-two">CONNECT</span><span class="orbit-dot dot-one"></span><span class="orbit-dot dot-two"></span></div> : <div class="route-visual"><div class="route-input">CLIENT <span>→</span></div><div class="route-hub"><img src="/brand/cluster-route.svg" width="56" height="56" alt="" /></div><div class="route-outputs"><span><i></i> ANTHROPIC</span><span><i></i> OPENAI</span><span><i></i> PROVIDERS</span></div></div>}
            </div>
            <div class="project-content"><div class="project-title"><h3>{project.name}</h3><span class="language"><i></i>{project.language}</span></div><p>{project.description}</p><div class="tags">{project.tags.map(tag => <span>{tag}</span>)}</div><div class="project-links"><a href={project.repo} target="_blank" rel="noopener noreferrer">探索项目 <Icon size={18}/></a><a href={project.readme} target="_blank" rel="noopener noreferrer">阅读文档 <span aria-hidden="true">↗</span></a></div>{index === 0 && <small class="upstream">延续 Clash Verge / Clash Verge Rev 开源项目</small>}</div>
          </article>)}
        </div>
      </section>
      <section id="about" class="about wrap" aria-labelledby="about-title">
        <div class="about-intro"><span class="eyebrow section-kicker">02 / THE WAY WE BUILD</span><h2 id="about-title">工具可以小，<br/>可能性可以很大<span>.</span></h2><p>OpenALC 的项目从具体需求出发：<br/>让连接的管理更直观，让模型的调用更灵活。<br/>把想法写成代码，也把代码留给每一个人。</p><a href={github} class="text-link" target="_blank" rel="noopener noreferrer">了解我们的 GitHub 组织 <span aria-hidden="true">↗</span></a></div>
        <div class="values"><div><span class="value-number">[01]</span><div><h3>从真实需求出发</h3><p>聚焦网络与模型工具，让复杂的配置有清晰的入口。</p></div><Icon name="arrow"/></div><div><span class="value-number">[02]</span><div><h3>在开放中构建</h3><p>代码、问题与改进都在 GitHub 上，欢迎一起讨论。</p></div><Icon name="arrow"/></div><div><span class="value-number">[03]</span><div><h3>让每一份贡献有价值</h3><p>一条反馈、一处文档修正、一个 Pull Request，都能让项目向前一步。</p></div><Icon name="arrow"/></div></div>
      </section>
      <section id="contribute" class="contribute wrap" aria-labelledby="contribute-title"><div class="contribute-banner"><div><span class="eyebrow">03 / BUILD WITH US</span><h2 id="contribute-title">下一步，和我们一起写<span>↗</span></h2><p>发现问题，分享想法，或提交你的第一行代码。</p></div><a class="button button-dark" href={`${github}?tab=repositories`} target="_blank" rel="noopener noreferrer">参与开源 <Icon name="github"/></a><span class="banner-watermark" aria-hidden="true">{ }</span></div><div class="contribution-paths"><a href="https://github.com/OpenALC/cluster-route/issues" target="_blank" rel="noopener noreferrer"><span>01</span><strong>反馈问题</strong><span>提交 Issue，帮助项目变得更好</span><Icon size={18}/></a><a href="https://github.com/OpenALC/cluster-route/pulls" target="_blank" rel="noopener noreferrer"><span>02</span><strong>贡献代码</strong><span>从一个小改进开始</span><Icon size={18}/></a><a href="https://github.com/OpenALC/Cluster-Link#readme" target="_blank" rel="noopener noreferrer"><span>03</span><strong>完善文档</strong><span>让下一位使用者更容易上手</span><Icon size={18}/></a></div></section>
    </main>
    <footer class="footer wrap"><a class="brand" href="#"><span class="brand-mark"><img src="/brand/cluster-route.svg" width="36" height="36" alt="" /></span>OpenALC<span class="brand-dot">/</span></a><span>开放的代码，连接更多可能。</span><div><span>© {new Date().getFullYear()} OpenALC</span><a href={github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="#">回到顶部 ↑</a></div></footer>
    <script>
      const menu = document.querySelector<HTMLButtonElement>('.menu-button');
      const mobileNav = document.querySelector<HTMLElement>('#mobile-nav');
      function closeMenu() { if (menu && mobileNav) { mobileNav.hidden = true; menu.setAttribute('aria-expanded', 'false'); menu.setAttribute('aria-label', '打开导航'); } }
      menu?.addEventListener('click', () => { if (!mobileNav) return; const open = menu.getAttribute('aria-expanded') !== 'true'; menu.setAttribute('aria-expanded', String(open)); menu.setAttribute('aria-label', open ? '关闭导航' : '打开导航'); mobileNav.hidden = !open; });
      mobileNav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', event => { if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') { closeMenu(); menu.focus(); } });
      const captions: Record<string, string> = { link: '可视化管理配置、代理节点与路由规则。', route: '统一模型入口，透明转发到多个供应商。' };
      document.querySelectorAll<HTMLButtonElement>('.diagram-option').forEach(button => button.addEventListener('click', () => { document.querySelectorAll('.diagram-option').forEach(option => { option.classList.remove('active'); option.setAttribute('aria-pressed', 'false'); }); button.classList.add('active'); button.setAttribute('aria-pressed', 'true'); const mode = button.dataset.mode ?? 'link'; const caption = document.querySelector('#diagram-caption'); if (caption) caption.textContent = captions[mode]; document.querySelector('.network-panel')?.classList.toggle('route-selected', mode === 'route'); }));
    </script>
  </body>
</html>
